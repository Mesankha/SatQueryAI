# SatQuery AI - Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# NVIDIA API Key (required only for real Phi-4-mini LLM parser path)
# Obtain from https://build.nvidia.com
# Not required for the demo/fallback path which uses deterministic parsing
nvidia_api_key=""

# Google Earth Engine Project ID (required for GEE ingestion)
# Not required for the demo which uses fixture data
gee_project_id=""

# Hugging Face Token (optional, for higher rate limits on model downloads)
hf_token=""

# Optional: Override default paths
# catalog_db="./data/catalog.db"
# faiss_index="./data/faiss.index"