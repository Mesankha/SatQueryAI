{
  "$defs": {
    "ExecutionTrace": {
      "properties": {
        "task_selected": {
          "default": "",
          "title": "Task Selected",
          "type": "string"
        },
        "tools_called": {
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Tools Called",
          "type": "array"
        },
        "candidates_considered": {
          "default": 0,
          "title": "Candidates Considered",
          "type": "integer"
        },
        "candidates_after_filter": {
          "default": 0,
          "title": "Candidates After Filter",
          "type": "integer"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        }
      },
      "title": "ExecutionTrace",
      "type": "object"
    },
    "ModelOutputs": {
      "properties": {
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "vqa_answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vqa Answer"
        },
        "grounding_bbox": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grounding Bbox"
        },
        "change_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Description"
        },
        "fusion_statement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fusion Statement"
        }
      },
      "title": "ModelOutputs",
      "type": "object"
    },
    "ResultItem": {
      "properties": {
        "image_id": {
          "title": "Image Id",
          "type": "string"
        },
        "rank": {
          "default": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "score_breakdown": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model_outputs": {
          "$ref": "#/$defs/ModelOutputs"
        },
        "explanation_text": {
          "default": "",
          "title": "Explanation Text",
          "type": "string"
        },
        "confidence_note": {
          "default": "",
          "title": "Confidence Note",
          "type": "string"
        }
      },
      "required": [
        "image_id"
      ],
      "title": "ResultItem",
      "type": "object"
    },
    "ScoreBreakdown": {
      "properties": {
        "semantic_sim": {
          "default": 0.0,
          "title": "Semantic Sim",
          "type": "number"
        },
        "geo_score": {
          "default": 0.0,
          "title": "Geo Score",
          "type": "number"
        },
        "temporal_score": {
          "default": 0.0,
          "title": "Temporal Score",
          "type": "number"
        },
        "modality_score": {
          "default": 0.0,
          "title": "Modality Score",
          "type": "number"
        },
        "change_score": {
          "default": 0.0,
          "title": "Change Score",
          "type": "number"
        }
      },
      "title": "ScoreBreakdown",
      "type": "object"
    },
    "ToolCall": {
      "properties": {
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "success": {
          "default": true,
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "tool_name",
        "model_name"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "properties": {
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/ResultItem"
      },
      "title": "Results",
      "type": "array"
    },
    "trace": {
      "$ref": "#/$defs/ExecutionTrace"
    }
  },
  "title": "Query Response",
  "type": "object",
  "description": "SatQuery query response schema"
}